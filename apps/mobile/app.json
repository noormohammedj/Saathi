{
  "expo": {
    "name": "Saathi",
    "slug": "saathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saathi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.iskconcoimbatore.saathi",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.iskconcoimbatore.saathi"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-video",
      "expo-audio",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Saathi uses your camera to scan the temple check-in QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Saathi uses your photos for your devotee profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Saathi confirms temple visits when you are at ISKCON Coimbatore."
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock Saathi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/Saathi/app"
    }
  }
}
